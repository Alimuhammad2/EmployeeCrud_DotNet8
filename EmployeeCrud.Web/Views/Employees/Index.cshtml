@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Employees</h1>
    <a asp-action="Create" class="btn btn-primary">Add New Employee</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Name / Department / Email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-link">Reset</a>
    </div>
</form>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(m => m.EmployeeName)</th>
            <th>@Html.DisplayNameFor(m => m.EmployeeDepartment)</th>
            <th>@Html.DisplayNameFor(m => m.EmployeeAge)</th>
            <th>@Html.DisplayNameFor(m => m.EmployeeEmail)</th>
            <th>@Html.DisplayNameFor(m => m.CheckInTime)</th>
            <th>@Html.DisplayNameFor(m => m.CheckOutTime)</th>
            <th style="width:200px">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.EmployeeName</td>
            <td>@item.EmployeeDepartment</td>
            <td>@item.EmployeeAge</td>
            <td>@item.EmployeeEmail</td>
            <td>@item.CheckInTime.ToString("dd-MMM-yyyy hh:mm tt")</td>
            <td>@(item.CheckOutTime?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="7" class="text-center text-muted">Koi employee nahi mila.</td></tr>
    }
    </tbody>
</table>
