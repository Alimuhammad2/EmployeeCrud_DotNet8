@model Employee
@{
    ViewData["Title"] = "Details";
}

<h1 class="h3">Employee Details</h1>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmployeeName)</dt>
    <dd class="col-sm-9">@Model.EmployeeName</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmployeeDepartment)</dt>
    <dd class="col-sm-9">@Model.EmployeeDepartment</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmployeeAge)</dt>
    <dd class="col-sm-9">@Model.EmployeeAge</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EmployeeEmail)</dt>
    <dd class="col-sm-9">@Model.EmployeeEmail</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CheckInTime)</dt>
    <dd class="col-sm-9">@Model.CheckInTime.ToString("dd-MMM-yyyy hh:mm tt")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CheckOutTime)</dt>
    <dd class="col-sm-9">@(Model.CheckOutTime?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
